# Particle Proterties
variable                        radii1          equal 0.00035
variable                        radii2          equal 0.0004
variable                        radii3          equal 0.00045
variable                        radii4          equal 0.0005
variable                        scale_fac       equal 8
variable                        scaled_radii1   equal ${radii1}*${scale_fac}
variable                        scaled_radii2   equal ${radii2}*${scale_fac}
variable                        scaled_radii3   equal ${radii3}*${scale_fac}
variable                        scaled_radii4   equal ${radii4}*${scale_fac}
variable                        density         equal 2750
variable                        youngsModulus   equal 3e8
variable                        poissonsRatio   equal 0.3
variable                        amplitude       equal 2*${scaled_radii1}
        
# Reyleigh Time Calculation
variable Rtime equal ${scaled_radii1}*PI*sqrt((${density}/${youngsModulus})*(1+${poissonsRatio})/((0.1631*${poissonsRatio}+0.8766)*(1-${poissonsRatio}*${poissonsRatio})))

# CED0K, fr0.1 as the reference 
atom_style  granular
boundary    f f f  	 
units	    si
communicate single vel yes
newton	    off
# Read in the restart file
read_restart insertion.liggghts

variable    cut_off_dis equal 4*${radii1}    # 2*d(min)
neighbor	${cut_off_dis} bin      
neigh_modify delay 0 

#Material properties required for new pair styles, # 2 Types of particles

fix m1 all property/global youngsModulus peratomtype 3.0e8 3.0e8 
fix m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.2 0.2 0.2 0.2
fix m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.41 0.41 0.5				   
fix m5 all property/global coefficientRollingFriction peratomtypepair 2 0.35 0.46 0.46 0.35  
#fix m6 all property/global characteristicVelocity scalar 2
#fix m7 all property/global cohesionEnergyDensity peratomtypepair 2 0 0 0 0
#fix  m8 all property/global minSeparationDistanceRatio scalar 1.01
#fix  m9 all property/global maxSeparationDistanceRatio scalar 1.1
#fix  m10 all property/global surfaceLiquidContentInitial scalar 18.5 # %  # 10% 12%
#fix  m11 all property/global surfaceTension scalar 3.2 
#fix  m12 all property/global fluidViscosity scalar 0.00089 # Pa.s
#fix  m13 all property/global contactAngle peratomtype 60 60

#pair_style 	gran model hertz tangential history cohesion easo/capillary/viscous rolling_friction epsd2 
pair_style 	gran model hertz tangential history rolling_friction epsd2 
pair_coeff  * *

###########################################################################################################################################

variable				    timestep equal 0.2*${Rtime} # 10% Rayleigh Time
timestep				    ${timestep}

# Statinary time
variable                    staytime equal 0.2
variable                    staystep equal ${staytime}/${timestep}

# Open time
variable                    opentime equal 0.1 
variable                    opensteps equal ${opentime}/${timestep}

# Discharge time
variable	                dischargetime	equal	0.6 #seconds
variable	                dischargesteps	equal	${dischargetime}/${timestep}	#Transform time to iteration steps

# Dump											
variable		            dumptime equal 0.1 # dump every 20000 timesteps
variable 		            dumpsteps equal ceil(${dumptime}/${timestep})

compute  e all pair/gran/local pos id force vel force_normal force_tangential torque contactArea delta #contactPoint

compute              peratom all stress/atom
compute              p all reduce sum c_peratom[1] c_peratom[2] c_peratom[3]

################################################################################################################################################
# Generation and loading of geometry STL files

fix				            box all mesh/surface file Box.stl type 2 heal auto_remove_duplicates scale 0.001 move -0.25 -0.1 0.0							
fix					        lid all mesh/surface file Lid.stl type 2 heal auto_remove_duplicates scale 0.001 move -0.25 -0.1 0.002                                    
fix					        ground all mesh/surface file Ground.stl type 2 heal auto_remove_duplicates scale 0.001 move -0.25 -0.1 0.0
fix                         top all mesh/surface file top.stl type 2 heal auto_remove_duplicates scale 0.001 move -0.25 -0.1 -0.125
fix				            adjust1 all mesh/surface file adjust1.stl type 2 heal auto_remove_duplicates scale 0.001 move -0.26 -0.1 0.0
fix				            adjust2 all mesh/surface file adjust2.stl type 2 heal auto_remove_duplicates scale 0.001 move -0.24 -0.1 0.0                             
fix 			            walls all wall/gran model hertz tangential history rolling_friction epsd2 mesh n_meshes 6 meshes box lid ground top adjust1 adjust2

# Generation and insertion of the particles 

fix		    		        pts1 all particletemplate/sphere 32452843 atom_type 1 density constant ${density} radius constant ${scaled_radii1} 
fix					        pts2 all particletemplate/sphere 15485863 atom_type 1 density constant ${density} radius constant ${scaled_radii2}  
fix					        pts3 all particletemplate/sphere 15485867 atom_type 1 density constant ${density} radius constant ${scaled_radii3} 
fix					        pts4 all particletemplate/sphere 32452867 atom_type 1 density constant ${density} radius constant ${scaled_radii4} 
fix		   			        pdd1 all particledistribution/discrete/numberbased 49979687 4 pts1 0.25 pts2 0.25 pts3 0.25 pts4 0.25  
                  

# Apply nve integration to all particles that are inserted as single particles
fix	integrator all nve/sphere 
fix gravity all gravity 9.81 vector 0.0 0.0 -1.0

# Dumping
run 1 
dump				 	    dmpparticle all custom/vtk ${dumpsteps} Test_loose/Particels*.vtk  id type type x y z vx vy vz fx fy fz omegax omegay omegaz radius
dump					    dmptopbox all mesh/stl ${dumpsteps} Test_loose/box*.stl box
dump					    dmpopening all mesh/stl ${dumpsteps} Test_loose/lid*.stl lid
dump					    dmpbottombox all mesh/stl ${dumpsteps} Test_loose/ground*.stl ground
dump					    dmmtop all mesh/stl ${dumpsteps} Test_loose/top*.stl top
dump                        dumpadjust1 all mesh/stl ${dumpsteps} Test_loose/adjust1*.stl adjust1
dump                        dumpadjust2 all mesh/stl ${dumpsteps} Test_loose/adjust1*.stl adjust2
dump                        dumpcontact all local/gran/vtk ${dumpsteps} Test_loose/Contact*.vtk e 
dump                        dumpcontact1 all custom/vtk  ${dumpsteps} Test_loose/stress*.vtk  c_peratom[1] c_peratom[2] c_peratom[3] 

run                         ${staystep}

# Run the opening
fix 				         movemesh all move/mesh mesh lid linear 1.5 0 0
run                          ${opensteps}
unfix	                     movemesh  

# Run the discharing
run	                        ${dischargesteps}
